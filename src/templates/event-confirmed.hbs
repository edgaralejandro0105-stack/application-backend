    <ul style="list-style-type: none; padding: 0; margin: 0; color: #27272a;">
        <li style="margin-bottom: 10px;"><strong>Salón:</strong> {{salon}}</li>
        <li style="margin-bottom: 10px;"><strong>Fecha:</strong> {{fecha}}</li>
