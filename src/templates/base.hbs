<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>La Casona</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #f4f4f5; /* zinc-100 */
            margin: 0;
            padding: 40px 20px;
            color: #27272a; /* zinc-800 */
            -webkit-font-smoothing: antialiased;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        .header {
            background-color: #18181b; /* zinc-900 */
            color: #ffffff;
            text-align: center;
            padding: 32px 20px;
        }
        .header h1 {
            margin: 0;
            font-size: 24px;
            font-weight: 700;
            letter-spacing: 1px;
        }
        .header p {
            margin: 8px 0 0 0;
            font-size: 14px;
            color: #a1a1aa; /* zinc-400 */
        }
        .content {
            padding: 40px 32px;
            line-height: 1.6;
        }
        .footer {
            background-color: #fafafa; /* zinc-50 */
            text-align: center;
            padding: 24px;
            font-size: 12px;
            color: #71717a; /* zinc-500 */
            border-top: 1px solid #e4e4e7; /* zinc-200 */
        }
        .button {
            display: inline-block;
            background-color: #18181b; /* zinc-900 */
            color: #ffffff !important;
            text-decoration: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            margin-top: 24px;
            text-align: center;
        }
        /* Tabla para reportes */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 24px;
            font-size: 14px;
        }
        .data-table th, .data-table td {
            border-bottom: 1px solid #e4e4e7;
            padding: 12px 16px;
            text-align: left;
        }
        .data-table th {
            background-color: #f4f4f5;
            font-weight: 600;
            color: #3f3f46;
        }
        @media only screen and (max-width: 600px) {
            body {
                padding: 0;
            }
            .container {
                width: 100%;
                border-radius: 0;
                box-shadow: none;
            }
            .content {
                padding: 24px 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <!-- Branding -->
            <h1>LA CASONA</h1>
            <p>Sistema Integrado de Gestión Empresarial</p>
        </div>
        <div class="content">
            {{{body}}}
        </div>
        <div class="footer">
            <p>&copy; {{currentYear}} La Casona Eventos. Todos los derechos reservados.</p>
            <p>Este es un mensaje generado automáticamente. Por favor, no respondas a este correo.</p>
        </div>
    </div>
</body>
</html>
